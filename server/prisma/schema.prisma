// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models for USM website

model News {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  resumen     String?  @db.Text
  image       String   @db.Text
  category    String
  date        DateTime
  url         String   @unique @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  description String   @db.Text
  resumen     String?  @db.Text
  date        DateTime
  hour        String
  modality    Modality
  image       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id        Int        @id @default(autoincrement())
  title     String     @db.Text
  url       String     @unique
  category  GalleryCategory
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  image     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
}

// Enums
enum Modality {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
}

enum GalleryCategory {
  EVENTOS
  INSTALACIONES
  ESTUDIANTES
}

enum Role {
  USER
  ADMIN
}
